# Copy this file to .env and fill only the variables you actually need.

# T-Invest read-only token.
TINVEST_TOKEN=
TINVEST_SSL_VERIFY=true
TINVEST_CA_BUNDLE=

# Optional Cbonds credentials.
CBONDS_API_LOGIN=
CBONDS_API_PASSWORD=
CBONDS_ENDPOINT_PATH=
CBONDS_API_URL=https://cbonds.com/api/services/json/
